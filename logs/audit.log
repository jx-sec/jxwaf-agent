_time)\\n    if not count then\\n        return\\n    end\\n\\n    -- 3. 超过请求阈值时，每IP每窗口仅累加一次接口风险次数\\n    if count \\u003e req_threshold then\\n        -- add 原子操作：仅当 key 不存在时写入成功，确保每IP每窗口只触发一次\\n        local risk_trigger_key = project_name .. \\\"_risk_triggered|\\\" .. path .. \\\"|\\\" .. src_ip\\n        local ok = dict:add(risk_trigger_key, \\\"1\\\", stat_time)\\n        if ok then\\n            -- 首次触发，累加接口风险次数\\n            local risk_count_key = project_name .. \\\"_risk_count|\\\" .. path\\n            local risk_count, rc_err = dict:incr(risk_count_key, 1, 0, risk_window)\\n            if risk_count then\\n                -- 刷新风险计数窗口TTL，持续触发则持续累积，停止触发后risk_window秒自动过期重置\\n                dict:expire(risk_count_key, risk_window)\\n\\n                -- 4. 接口风险次数超过阈值，对该接口开启人机识别\\n                if risk_count \\u003e risk_threshold then\\n                    dict:set(enforce_key, \\\"1\\\", bot_check_duration)\\n                    ngx.ctx.waf_log = {\\n                        waf_module = \\\"component\\\",\\n                        waf_policy = \\\"防护组件-api_risk_bot_check\\\",\\n                        waf_action = \\\"bot_check\\\",\\n                        waf_extra = \\\"risk_count exceeded, path=\\\" .. path .. \\\" risk_count=\\\" .. tostring(risk_count) .. \\\" src_ip=\\\" .. src_ip,\\n                    }\\n                    unify_action.bot_commit_auth()\\n                    unify_action.bot_check_ip(bot_check_type)\\n                    return\\n                end\\n            end\\n        end\\n    end\\n\\n    return\\nend\\n\\nreturn _M\\n\",\"conf_json\":\"{\\\"bot_check_type\\\":\\\"slipper\\\",\\\"bot_check_duration\\\":600,\\\"project_name\\\":\\\"api_risk_control\\\",\\\"req_threshold\\\":120,\\\"risk_threshold\\\":5,\\\"risk_window\\\":300,\\\"stat_time\\\":60}\",\"explanation\":\"防护组件 api_risk_bot_check。Lua 代码 3665 字节，请确认兼容 LuaJIT（Lua 5.1）。\",\"load_hint\":\"复制上方 JSON，在控制台「防护组件 → 加载」中粘贴导入。Lua 代码必须兼容 LuaJIT（Lua 5.1）。\"}","success