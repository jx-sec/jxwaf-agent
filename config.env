# JXWAF Agent 环境变量配置
# 复制此文件为 config.env 并填写实际值

# JXWAF 控制台 API 地址（专业版）
JXWAF_API_URL=https://user.jxwaf.com

# WAF 认证 Token（外部 API 调用用，在控制台「系统配置」中获取）
JXWAF_WAF_AUTH=your_waf_auth_token_here

# 默认分组名（专业版域名分组，标准版可忽略）
JXWAF_GROUP=default

# 验证目标 URL（verify.py 默认使用，可按需修改）
JXWAF_VERIFY_URL=https://demo.jxwaf.com
