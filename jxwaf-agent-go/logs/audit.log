{"time":"2026-06-19T00:22:09.719501+08:00","session_id":"20260619-001936.824","function":"create_component","arguments":"{\"name\":\"detect_sqli_in_user_agent\",\"detail\":\"检测请求头 User-Agent 是否包含 SQL 注入特征（Union Select、Sleep、Information_schema 等常见注入 Payload），命中后执行阻断/观察动作。新规则建议先 watch 模式观察，验证无误报后改为 block。\",\"code_lua\":\"local _M = {}\\n\\nfunction _M.check(conf_data)\\n    if conf_data == nil then\\n        return\\n    end\\n\\n    local unify_action = require \\\"resty.jxwaf.unify_action\\\"\\n\\n    -- 获取 User-Agent 请求头\\n    local headers = ngx.req.get_headers()\\n    local user_agent = headers[\\\"User-Agent\\\"] or headers[\\\"user-agent\\\"]\\n    if user_agent == nil or user_agent == \\\"\\\" then\\n        return\\n    end\\n\\n    -- SQL 注入特征正则（不区分大小写）\\n    local sqli_patterns = {\\n        \\\"union\\\\\\\\s+select\\\",\\n        \\\"union\\\\\\\\s+all\\\\\\\\s+select\\\",\\n        \\\"select\\\\\\\\s+.+\\\\\\\\s+from\\\",\\n        \\\"insert\\\\\\\\s+into\\\",\\n        \\\"delete\\\\\\\\s+from\\\",\\n        \\\"drop\\\\\\\\s+table\\\",\\n        \\\"update\\\\\\\\s+.+\\\\\\\\s+set\\\",\\n        \\\"or\\\\\\\\s+1\\\\\\\\s*=\\\\\\\\s*1\\\",\\n        \\\"and\\\\\\\\s+1\\\\\\\\s*=\\\\\\\\s*1\\\",\\n        \\\"or\\\\\\\\s+'1'\\\\\\\\s*=\\\\\\\\s*'1'\\\",\\n        \\\"and\\\\\\\\s+'1'\\\\\\\\s*=\\\\\\\\s*'1'\\\",\\n        \\\"information_schema\\\",\\n        \\\"sleep\\\\\\\\s*\\\\\\\\(\\\",\\n        \\\"benchmark\\\\\\\\s*\\\\\\\\(\\\",\\n        \\\"load_file\\\\\\\\s*\\\\\\\\(\\\",\\n        \\\"into\\\\\\\\s+outfile\\\",\\n        \\\"into\\\\\\\\s+dumpfile\\\",\\n        \\\"waitfor\\\\\\\\s+delay\\\",\\n        \\\"xp_cmdshell\\\",\\n        \\\"exec\\\\\\\\s*\\\\\\\\(\\\",\\n        \\\"declare\\\\\\\\s+@\\\",\\n        \\\"0x[0-9a-fA-F]{6,}\\\"\\n    }\\n\\n    for _, pattern in ipairs(sqli_patterns) do\\n        local m, err = ngx.re.match(user_agent, pattern, \\\"ioj\\\")\\n        if m then\\n            -- 设置上下文变量，供联合判断使用\\n            ngx.ctx.sqli_in_ua = true\\n            ngx.ctx.sqli_pattern = pattern\\n            -- 执行动作（block / watch）\\n            local action = conf_data.action or \\\"block\\\"\\n            unify_action.do_action(action, \\\"User-Agent SQL Injection detected\\\")\\n            return\\n        end\\n    end\\n\\n    return\\nend\\n\\nreturn _M\",\"conf\":\"{\\\"action\\\": \\\"watch\\\"}\"}","result":"ERROR: Post \"https://user.jxwaf.com/waf/create_component\": dial tcp: lookup user.jxwaf.com: no such host","success":false}
